{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch QEMU (Debug Mode)",
            "type": "shell",
            "command": "./scripts/run_qemu.sh",
            "args": [
                "--debug"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "Starting QEMU...",
                        "endsPattern": "Exit: Ctrl\\+A then X"
                    }
                }
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}