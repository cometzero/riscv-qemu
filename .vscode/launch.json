{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach to QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/u-boot/spl/u-boot-spl",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1234",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load project specific debug script",
                    "text": "source ${workspaceFolder}/scripts/debug.gdb"
                }
            ],
            "launchCompleteCommand": "None",
            "MIMode": "gdb"
        }
    ]
}